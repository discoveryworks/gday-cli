#!/bin/bash

# gday - Personal calendar and task management CLI
# Integrates Google Calendar with daily productivity workflows

# Set script directory for library imports
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Source library functions
source "$SCRIPT_DIR/lib/version.sh"
source "$SCRIPT_DIR/lib/banner.sh"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/calendar.sh"
source "$SCRIPT_DIR/lib/oura.sh"

# Helper function to show only the "Later Today" section
gday_later_today_section() {
  local sort_type="${1:-alpha}"  # Default to appointment grouping
  gday_show_banner

  # Load configuration
  if ! gday_load_config; then
    return 1
  fi

  # Get filtered appointments
  local filtered_appointments=$(gday_parse_filtered_appointments)

  # Get today's calendar data
  local calendar_data=$(gday_get_calendar_data "today")

  # Calculate target date for filtering events
  local target_day=$(date "+%a")
  local target_month=$(date "+%b")
  local target_date=$(date "+%d")

  # Process calendar data and generate table with sort type
  local body=$(gday_process_calendar_data "$calendar_data" "$target_day" "$target_month" "$target_date" "$sort_type")

  # Generate filtered "Later Today" section
  echo "$body" | generate_later_today_h2s "$filtered_appointments"
}

# Helper function to show filtered appointments
gday_show_filtered_appointments() {
  gday_show_banner

  local config_file="$HOME/.config/gday/config.yml"
  if [[ ! -f "$config_file" ]]; then
    echo "Error: Configuration file not found at $config_file"
    return 1
  fi

  echo "## Filtered Appointments"
  echo "The following appointments are excluded from 'Later Today' section:"
  echo ""

  local in_filtered_appointments=false

  while IFS= read -r line; do
    if [[ "$line" =~ ^filtered_appointments: ]]; then
      in_filtered_appointments=true
    elif [[ $in_filtered_appointments == true && "$line" =~ ^[[:space:]]*-[[:space:]]*(.*) ]]; then
      local appointment=$(echo "$line" | sed 's/^[[:space:]]*-[[:space:]]*//' | sed 's/^"//' | sed 's/"$//')
      echo "- $appointment"
    elif [[ "$line" =~ ^[[:alpha:]]+: ]] && [[ $in_filtered_appointments == true ]]; then
      # New section started, stop processing filtered appointments
      break
    fi
  done < "$config_file"
}

# Helper function to edit config file
gday_edit_config() {
  local config_file="$HOME/.config/gday/config.yml"
  
  # Create config directory if it doesn't exist
  if [[ ! -d "$(dirname "$config_file")" ]]; then
    mkdir -p "$(dirname "$config_file")"
  fi
  
  # Check if config file exists
  if [[ ! -f "$config_file" ]]; then
    echo "Configuration file not found at: $config_file"
    echo "Creating a new config file from template..."
    
    # Check if we have a template in the repo
    local template_file="$SCRIPT_DIR/config.yml.example"
    if [[ -f "$template_file" ]]; then
      cp "$template_file" "$config_file"
      echo "Created config file from template: $template_file"
    else
      echo "Error: Template file not found at $template_file"
      echo "Please create a config file manually or see the documentation"
      return 1
    fi
  fi
  
  # Determine which editor to use
  local editor=""
  if [[ -n "$VISUAL" ]]; then
    editor="$VISUAL"
  elif [[ -n "$EDITOR" ]]; then
    editor="$EDITOR"
  elif command -v code >/dev/null 2>&1; then
    editor="code"
  elif command -v nano >/dev/null 2>&1; then
    editor="nano"
  elif command -v vim >/dev/null 2>&1; then
    editor="vim"
  elif command -v vi >/dev/null 2>&1; then
    editor="vi"
  else
    echo "No suitable editor found. Please set EDITOR or VISUAL environment variable."
    echo "Config file location: $config_file"
    return 1
  fi
  
  echo "Opening config file in $editor..."
  "$editor" "$config_file"
  
  # After editing, refresh calendar data to pick up any new calendars
  echo ""
  echo "Config file updated. Refreshing calendar data..."
  
  # Load the updated config
  if gday_load_config; then
    gday_refresh_calendars
  else
    echo "Warning: Could not load updated config. Refresh skipped."
  fi
}

# Helper function to show help
gday_show_help() {
  gday_show_banner

  echo "gday - Personal calendar and task management tool"
  echo ""
  echo "USAGE:"
  echo "  gday [COMMAND] [FLAGS] [DATE]"
  echo ""
  echo "COMMANDS:"
  echo "  auth              Re-authenticate with Google Calendar"
  echo "  refresh           Refresh calendar data cache"
  echo "  later             Show only the 'Later Today' section"
  echo "  filtered          Show the list of filtered appointments"
  echo "  oura, health      Show Oura ring health data"
  echo "  conf, edit, config Edit the configuration file"
  echo "  help, --help, -h  Show this help message"
  echo "  --version, -v     Show version information"
  echo ""
  echo "DATE FLAGS:"
  echo "  --today           Show today's schedule (default)"
  echo "  --yesterday, --prev Show yesterday's schedule"
  echo "  --monday, --mon   Show most recent Monday's schedule"
  echo "  --tuesday, --tue  Show most recent Tuesday's schedule"
  echo "  --wednesday, --wed Show most recent Wednesday's schedule"
  echo "  --thursday, --thu Show most recent Thursday's schedule"
  echo "  --friday, --fri   Show most recent Friday's schedule"
  echo "  --saturday, --sat Show most recent Saturday's schedule"
  echo "  --sunday, --sun   Show most recent Sunday's schedule"
  echo "  YYYY-MM-DD        Show specific date (e.g., 1986-06-05)"
  echo "  MM/DD/YYYY        Show specific date (e.g., 06/05/1986)"
  echo "  \"Month DD, YYYY\"  Show specific date (e.g., \"June 5, 1986\")"
  echo ""
  echo "SORTING FLAGS:"
  echo "  --sort-alpha      Group appointments together (default)"
  echo "  --sort-interleaved Sort all entries by time (chronological)"
  echo ""
  echo "HEALTH DATA OPTIONS:"
  echo "  --oura            Show only Oura ring health data"
  echo ""
  echo "EXAMPLES:"
  echo "  gday              Show today's full schedule"
  echo "  gday --yesterday  Show yesterday's schedule"
  echo "  gday --friday     Show last Friday's schedule"
  echo "  gday 1986-06-05   Show Ferris Bueller's legendary day"
  echo "  gday \"June 5, 1986\" Same date with natural language"
  echo "  gday later        Show only appointments for later today"
  echo "  gday filtered     Show which appointments are filtered out"
  echo "  gday health --yesterday Show yesterday's Oura health data"
  echo "  gday --sort-interleaved --friday Show Friday with strict time sorting"
  echo "  gday --sort-alpha --yesterday Show yesterday with appointment grouping"
  echo ""
  echo "LEGACY SUPPORT:"
  echo "  gday yesterday    Still works (same as gday --yesterday)"
  echo "  gday friday       Still works (same as gday --friday)"
  echo ""
  echo "VERSION: $GDAY_VERSION"
}

# Parse arbitrary date formats
parse_arbitrary_date() {
  local input_date="$1"
  local parsed_date=""

  # Try different date formats
  # ISO format: 1986-06-05
  if [[ "$input_date" =~ ^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$ ]]; then
    parsed_date=$(date -j -f "%Y-%m-%d" "$input_date" "+%Y-%m-%d" 2>/dev/null)
  # US format: 06/05/1986 or 6/5/1986
  elif [[ "$input_date" =~ ^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$ ]]; then
    parsed_date=$(date -j -f "%m/%d/%Y" "$input_date" "+%Y-%m-%d" 2>/dev/null)
  # Alternative US format: 1986/06/05
  elif [[ "$input_date" =~ ^[0-9]{4}/[0-9]{1,2}/[0-9]{1,2}$ ]]; then
    parsed_date=$(date -j -f "%Y/%m/%d" "$input_date" "+%Y-%m-%d" 2>/dev/null)
  # Try parsing with date command (handles "June 5, 1986", etc.)
  else
    parsed_date=$(date -j -f "%B %d, %Y" "$input_date" "+%Y-%m-%d" 2>/dev/null)
    if [[ -z "$parsed_date" ]]; then
      parsed_date=$(date -j -f "%b %d, %Y" "$input_date" "+%Y-%m-%d" 2>/dev/null)
    fi
  fi

  # If we successfully parsed the date, set the global variables
  if [[ -n "$parsed_date" ]]; then
    date_arg="$parsed_date"
    display_date=$(date -j -f "%Y-%m-%d" "$parsed_date" "+%m/%d - %A" 2>/dev/null)
    week_number=$(date -j -f "%Y-%m-%d" "$parsed_date" "+%V" 2>/dev/null)
    return 0
  else
    return 1
  fi
}

# Normalize weekday input to handle abbreviations
normalize_weekday() {
  local input=$(echo "$1" | tr '[:upper:]' '[:lower:]')

  case "$input" in
    monday|mon) echo "monday" ;;
    tuesday|tues|tue) echo "tuesday" ;;
    wednesday|wed) echo "wednesday" ;;
    thursday|thurs|thur|thu) echo "thursday" ;;
    friday|fri) echo "friday" ;;
    saturday|sat) echo "saturday" ;;
    sunday|sun) echo "sunday" ;;
    *) echo "" ;;  # Invalid weekday
  esac
}

# Parse command line arguments into commands and flags
parse_args() {
  local command=""
  local date_flag=""
  local sort_flag=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Date flags
      --yesterday|--prev)
        date_flag="yesterday"
        shift
        ;;
      --today)
        date_flag="today"
        shift
        ;;
      --monday|--mon)
        date_flag="monday"
        shift
        ;;
      --tuesday|--tue)
        date_flag="tuesday"
        shift
        ;;
      --wednesday|--wed)
        date_flag="wednesday"
        shift
        ;;
      --thursday|--thu)
        date_flag="thursday"
        shift
        ;;
      --friday|--fri)
        date_flag="friday"
        shift
        ;;
      --saturday|--sat)
        date_flag="saturday"
        shift
        ;;
      --sunday|--sun)
        date_flag="sunday"
        shift
        ;;
      # Sort flags
      --sort-alpha)
        sort_flag="alpha"
        shift
        ;;
      --sort-interleaved)
        sort_flag="interleaved"
        shift
        ;;
      # Commands (prioritize flags over old command style)
      auth|later|filtered|oura|health|conf|edit|config|refresh|help|--help|-h|--version|-v|--oura|--oura-debug)
        command="$1"
        shift
        ;;
      # Legacy date arguments (for backward compatibility)
      prev|yesterday|then)
        if [[ -z "$date_flag" ]]; then
          date_flag="yesterday"
        fi
        shift
        ;;
      # Weekday arguments (legacy) - handle both full names and abbreviations
      monday|mon|tuesday|tue|tues|wednesday|wed|thursday|thu|thurs|friday|fri|saturday|sat|sunday|sun)
        if [[ -z "$date_flag" ]]; then
          normalized_day=$(normalize_weekday "$1")
          if [[ -n "$normalized_day" ]]; then
            date_flag="$normalized_day"
          fi
        fi
        shift
        ;;
      # Unknown flags starting with --
      --*)
        echo "Error: Unknown flag '$1'"
        echo "Run 'gday --help' for usage information"
        return 1
        ;;
      *)
        # Try to parse as date format (YYYY-MM-DD, MM/DD/YYYY, etc.) or unknown argument
        if [[ -z "$date_flag" ]]; then
          # First try to normalize as weekday (catches uppercase abbreviations)
          local normalized_day=$(normalize_weekday "$1")
          if [[ -n "$normalized_day" ]]; then
            date_flag="$normalized_day"
          # Then check if it's a potential date format
          elif [[ "$1" =~ ^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$ ]] || [[ "$1" =~ ^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$ ]] || [[ "$1" =~ ^[A-Za-z] ]]; then
            date_flag="custom:$1"
          else
            echo "Error: Invalid date argument '$1'"
            echo "Run 'gday --help' for usage information"
            return 1
          fi
        fi
        shift
        ;;
    esac
  done

  # Set global variables
  GDAY_COMMAND="${command:-}"
  GDAY_DATE_FLAG="${date_flag:-today}"
  GDAY_SORT_FLAG="${sort_flag:-alpha}"
}

# Process date flag to set display variables
process_date_flag() {
  case "$GDAY_DATE_FLAG" in
    yesterday)
      date_arg="yesterday"
      display_date=$(date -v -1d "+%m/%d - %A")
      week_number=$(date -v -1d "+%V")
      ;;
    today)
      date_arg="today"
      display_date=$(date "+%m/%d - %A")
      week_number=$(date "+%V")
      ;;
    monday|tuesday|wednesday|thursday|friday|saturday|sunday)
      # Handle weekday flags
      day_lower="$GDAY_DATE_FLAG"
      day_display=$(echo "$day_lower" | sed 's/./\U&/')

      # Find the most recent occurrence of the specified day
      current_day=$(date "+%A" | tr '[:upper:]' '[:lower:]')

      if [[ "$current_day" == "$day_lower" ]]; then
        # If today is the requested day, just use today
        date_arg="today"
        display_date=$(date "+%m/%d - %A")
        week_number=$(date "+%V")
      else
        # Calculate days ago - reuse existing logic
        current_day_num=$(date "+%w")
        target_day_num=0

        case "$day_lower" in
          sunday) target_day_num=0 ;;
          monday) target_day_num=1 ;;
          tuesday) target_day_num=2 ;;
          wednesday) target_day_num=3 ;;
          thursday) target_day_num=4 ;;
          friday) target_day_num=5 ;;
          saturday) target_day_num=6 ;;
        esac

        # Calculate days ago
        if [[ $current_day_num -gt $target_day_num ]]; then
          days_ago=$((current_day_num - target_day_num))
        else
          days_ago=$((7 + current_day_num - target_day_num))
        fi

        date_arg="$days_ago days ago"
        display_date=$(date -v-${days_ago}d "+%m/%d - %A")
        week_number=$(date -v-${days_ago}d "+%V")
      fi
      ;;
    custom:*)
      # Handle custom date formats
      custom_date="${GDAY_DATE_FLAG#custom:}"
      if parse_arbitrary_date "$custom_date"; then
        # Successfully parsed - variables set by parse_arbitrary_date
        return 0
      else
        echo "Error: Unable to parse date '$custom_date'"
        echo "Supported formats: YYYY-MM-DD, MM/DD/YYYY, \"Month DD, YYYY\""
        return 1
      fi
      ;;
    *)
      # Default to today
      date_arg="today"
      display_date=$(date "+%m/%d - %A")
      week_number=$(date "+%V")
      ;;
  esac

  return 0
}

# Process prompts from YAML configuration
process_prompts() {
  local config_file="$HOME/.config/gday/config.yml"
  # Parse new YAML structure
  # Using indexed arrays instead of associative arrays for compatibility
  prompt_groups=()
  prompt_frequencies=()
  prompt_contents=()

  # Arrays for storing group data (index-based for compatibility)
  group_names=()
  group_frequencies=()
  group_contents=()
  local current_group=""
  local current_frequency=""
  local in_content=false
  local in_prompts=false

  while IFS= read -r line; do
    # Check for prompts section
    if [[ "$line" =~ ^prompts: ]]; then
      in_prompts=true
      continue
    fi

    # Stop when we hit a non-prompts section
    if [[ "$line" =~ ^[[:alpha:]_]+: ]] && [[ $in_prompts == true ]] && [[ ! "$line" =~ ^[[:space:]] ]]; then
      break
    fi

    if [[ $in_prompts == true ]]; then
      if [[ "$line" =~ ^[[:space:]]*-[[:space:]]*name:[[:space:]]*\"(.*)\" ]]; then
        # Start of new prompt group
        current_group="${BASH_REMATCH[1]}"
        in_content=false
      elif [[ "$line" =~ ^[[:space:]]*frequency:[[:space:]]*(.*) ]]; then
        # Frequency line
        current_frequency="${BASH_REMATCH[1]}"
        # Remove comments
        current_frequency=$(echo "$current_frequency" | sed 's/#.*//' | sed 's/[[:space:]]*$//')
        # Find or add group index
        local group_index=-1
        for i in "${!group_names[@]}"; do
          if [[ "${group_names[$i]}" == "$current_group" ]]; then
            group_index=$i
            break
          fi
        done
        if [[ $group_index -eq -1 ]]; then
          group_names+=("$current_group")
          group_frequencies+=("$current_frequency")
          group_contents+=("")
          group_index=$((${#group_names[@]} - 1))
        else
          group_frequencies[$group_index]="$current_frequency"
        fi
      elif [[ "$line" =~ ^[[:space:]]*content: ]]; then
        # Start of content section
        in_content=true
        # Content will be accumulated below
      elif [[ $in_content == true && "$line" =~ ^[[:space:]]*-[[:space:]]*(.*) ]]; then
        # Content line
        local prompt=$(echo "$line" | sed 's/^[[:space:]]*-[[:space:]]*//' | sed 's/^"//' | sed 's/"$//')
        # Find group index and append to content
        local group_index=-1
        for i in "${!group_names[@]}"; do
          if [[ "${group_names[$i]}" == "$current_group" ]]; then
            group_index=$i
            break
          fi
        done
        if [[ $group_index -ne -1 ]]; then
          local current_content="${group_contents[$group_index]}"
          if [[ -z "$current_content" ]]; then
            group_contents[$group_index]="$prompt"
          else
            group_contents[$group_index]="$current_content|$prompt"
          fi
        fi
      fi
    fi
  done < "$config_file"

  # Process each prompt group based on frequency
  for i in "${!group_names[@]}"; do
    local group="${group_names[$i]}"
    local frequency="${group_frequencies[$i]}"
    local content="${group_contents[$i]}"
    # Split content by | delimiter
    IFS='|' read -a prompts <<< "$content"

    case "$frequency" in
      "daily")
        for prompt in "${prompts[@]}"; do
          echo -e "${prompt}\n\n"
        done
        ;;
      rotating\(*\))
        # Extract count from frequency string
        local count=$(echo "$frequency" | sed 's/rotating(\([0-9]*\))/\1/')
        local day_of_year=$(date +%j)
        local total_prompts=${#prompts[@]}
        # Calculate starting index for today
        local start_index=$(( (day_of_year * count) % total_prompts ))

        # Show the specified number of prompts
        for ((i = 0; i < count && i < total_prompts; i++)); do
          local index=$(( (start_index + i) % total_prompts ))
          echo -e "${prompts[$index]}\n\n"
        done
        ;;
      random\(*\))
        # Extract count from frequency string
        local count=$(echo "$frequency" | sed 's/random(\([0-9]*\))/\1/')
        local selected=()
        local available=("${prompts[@]}")

        # Seed random with date for consistency within the day
        RANDOM=$(date +%j)

        # Pick random prompts without replacement
        for ((i = 0; i < count && ${#available[@]} > 0; i++)); do
          local rand_index=$((RANDOM % ${#available[@]}))
          echo -e "${available[$rand_index]}\n\n"
          # Remove selected prompt from available list
          available=("${available[@]:0:$rand_index}" "${available[@]:$((rand_index + 1))}")
        done
        ;;
    esac
  done
}

# Core gday processing function with sort type support
gday_run() {
  local sort_type="${1:-alpha}"  # Default to appointment grouping
  shift  # Remove sort_type from remaining arguments
  
  # Handle special commands first
  case "$1" in
    auth)
      echo "Removing gcalcli OAuth token..."
      touch ~/.gcalcli_oauth
      rm ~/.gcalcli_oauth
      echo "running \`gcalcli agenda\`. If this fails, try \`gcalcli init\` to force the auth flow"
      gcalcli init
      return
      ;;
    later)
      # Only show the "Later Today" section
      gday_later_today_section "$sort_type"
      return
      ;;
    filtered)
      # Show filtered appointments from config
      gday_show_filtered_appointments
      return
      ;;
    --help|help|-h)
      gday_show_help
      return
      ;;
    --version|-v)
      gday_show_banner
      echo "VERSION: $GDAY_VERSION"
      return
      ;;
  esac

  # Process date arguments
  if ! process_date_args "$1"; then
    return 1
  fi

  # Load configuration
  if ! gday_load_config; then
    return 1
  fi

  # Show banner and validate calendars
  gday_show_banner
  
  # Show what date we're running for
  local target_date_display="${display_date:-today}"
  if [[ "$target_date_display" =~ ^[0-9]+/[0-9]+ ]]; then
    # For dates like "12/09 - Monday", extract just the day name or show full
    target_date_display="${display_date}"
  else
    target_date_display="today"
  fi
  echo "Running gday for $target_date_display"
  
  gday_validate_calendars

  echo ""
  echo "-------------------------------------"
  echo ""

  # Determine target date components based on date_format
  local target_day target_month target_date
  if [[ "$date_format" == "today" ]]; then
    target_day=$(date "+%a")
    target_month=$(date "+%b")
    target_date=$(date "+%d")
  else
    # Parse the date_arg to get day/month/date
    target_day=$(date -j -f "%Y-%m-%d" "$date_arg" "+%a" 2>/dev/null)
    target_month=$(date -j -f "%Y-%m-%d" "$date_arg" "+%b" 2>/dev/null)
    target_date=$(date -j -f "%Y-%m-%d" "$date_arg" "+%d" 2>/dev/null)
  fi

  # Get calendar data
  local calendar_data=$(gday_get_calendar_data "$date_arg")

  # Process calendar data with sort type
  local body=$(gday_process_calendar_data "$calendar_data" "$target_day" "$target_month" "$target_date" "$sort_type")

  # Format dateline
  local dateline="# $display_date"
  if [[ $display_date == *"Monday"* ]]; then
    dateline="# $display_date - 📆 Week $week_number"
  fi

  echo -e "${dateline}\n"

  # Display Oura health data if available
  if [[ -n "$OURA_PAT" ]]; then
    show_oura_data_with_date
  fi

  # Process and display prompts
  process_prompts

  # Display main schedule table
  local title="## 🪢 Todo Today"
  local table_header="| Time    | Item                                                                                   |"
  local table_separator="|---------|----------------------------------------------------------------------------------------|"
  local kicker="\n******* DO WHATEVER THE SCHEDULE TELLS ME. AND ONLY THAT.**********\n\n\n"

  echo -e "${title}\n${table_header}\n${table_separator}\n${body}\n\n"
  echo -e "${kicker}"

  # Generate filtered "Later Today" section
  local filtered_appointments=$(gday_parse_filtered_appointments)
  echo "$body" | generate_later_today_h2s "$filtered_appointments"
}

# Show Oura data with date flag support
show_oura_data_with_date() {
  # Calculate target date based on the date flag
  local target_date=""
  local is_historical="false"

  # For health data, Oura labels sleep sessions by the date they END (morning date):
  # - "health today" shows today's sleep session (the one that ended this morning)
  # - "health yesterday" shows yesterday's sleep session (the one that ended yesterday morning)
  # - This matches how Oura tags sessions in their API

  case "$GDAY_DATE_FLAG" in
    today)
      # Today's health = today's sleep session (ended this morning)
      target_date=$(date "+%Y-%m-%d")
      is_historical="false"
      ;;
    yesterday)
      # Yesterday's health = yesterday's sleep session
      target_date=$(date -v -1d "+%Y-%m-%d")
      is_historical="true"
      ;;
    monday|tuesday|wednesday|thursday|friday|saturday|sunday)
      # Calculate the date for the specified weekday
      if [[ "$date_arg" =~ ([0-9]+)\ days\ ago ]]; then
        local days_ago="${BASH_REMATCH[1]}"
        target_date=$(date -v "-${days_ago}d" "+%Y-%m-%d")
        is_historical="true"
      elif [[ "$date_arg" == "today" ]]; then
        target_date=$(date "+%Y-%m-%d")
        is_historical="false"
      else
        target_date=$(date "+%Y-%m-%d")
        is_historical="false"
      fi
      ;;
    custom:*)
      # Use the parsed date directly as Oura labels sessions by end date
      if [[ "$date_arg" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        target_date="$date_arg"
        is_historical="true"
      else
        target_date=$(date "+%Y-%m-%d")
        is_historical="false"
      fi
      ;;
    *)
      target_date=$(date "+%Y-%m-%d")
      is_historical="false"
      ;;
  esac

  # Call the existing Oura function with the calculated date
  format_oura_summary "$target_date" "$is_historical"
}

# Main gday function
main() {
  # Parse command line arguments
  if ! parse_args "$@"; then
    return 1
  fi

  # Process date flag to set display variables
  if ! process_date_flag; then
    return 1
  fi

  # Handle commands
  case "$GDAY_COMMAND" in
    auth)
      echo "Removing gcalcli OAuth token..."
      touch ~/.gcalcli_oauth
      rm ~/.gcalcli_oauth
      echo "running \`gcalcli agenda\`. If this fails, try \`gcalcli init\` to force the auth flow"
      gcalcli init
      return
      ;;
    later)
      # Only show the "Later Today" section
      gday_later_today_section "$GDAY_SORT_FLAG"
      return
      ;;
    filtered)
      # Show filtered appointments from config
      gday_show_filtered_appointments
      return
      ;;
    oura|health)
      # Show Oura ring data with date flag support
      show_oura_data_with_date
      return
      ;;
    conf|edit|config)
      # Open config file in default editor
      gday_edit_config
      return
      ;;
    refresh)
      # Refresh calendar data cache
      if ! gday_load_config; then
        return 1
      fi
      gday_refresh_calendars
      return
      ;;
    --help|help|-h)
      gday_show_help
      return
      ;;
    --version|-v)
      gday_show_banner
      echo "VERSION: $GDAY_VERSION"
      return
      ;;
    --oura)
      # Show only Oura data
      show_oura_data_with_date
      return
      ;;
    --oura-debug)
      # Show raw Oura API data for debugging
      show_oura_raw_data
      return
      ;;
  esac

  # Load configuration
  if ! gday_load_config; then
    return 1
  fi

  gday_show_banner
  
  # Show what date we're running for
  local target_date_display="${display_date:-today}"
  if [[ "$target_date_display" =~ ^[0-9]+/[0-9]+ ]]; then
    # For dates like "12/09 - Monday", extract just the day name or show full
    target_date_display="${display_date}"
  else
    target_date_display="today"
  fi
  echo "Running gday for $target_date_display"

  # Validate calendars first
  if ! gday_validate_calendars; then
    return 1
  fi

  # Calculate target date for filtering events
  local target_day target_month target_date

  if [[ "$date_arg" == "today" ]]; then
    target_day=$(date "+%a")
    target_month=$(date "+%b")
    target_date=$(date "+%d")
  elif [[ "$date_arg" == "yesterday" ]]; then
    target_day=$(date -v -1d "+%a")
    target_month=$(date -v -1d "+%b")
    target_date=$(date -v -1d "+%d")
  elif [[ "$date_arg" =~ ([0-9]+)\ days\ ago ]]; then
    local days_ago="${BASH_REMATCH[1]}"
    target_day=$(date -v "-${days_ago}d" "+%a")
    target_month=$(date -v "-${days_ago}d" "+%b")
    target_date=$(date -v "-${days_ago}d" "+%d")
  elif [[ "$date_arg" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    # Arbitrary date in YYYY-MM-DD format
    target_day=$(date -j -f "%Y-%m-%d" "$date_arg" "+%a" 2>/dev/null)
    target_month=$(date -j -f "%Y-%m-%d" "$date_arg" "+%b" 2>/dev/null)
    target_date=$(date -j -f "%Y-%m-%d" "$date_arg" "+%d" 2>/dev/null)
  fi

  # Get calendar data
  local calendar_data=$(gday_get_calendar_data "$date_arg")

  # Process calendar data with specified sort type
  local body=$(gday_process_calendar_data "$calendar_data" "$target_day" "$target_month" "$target_date" "$GDAY_SORT_FLAG")

  # Format dateline
  local dateline="# $display_date"
  if [[ $display_date == *"Monday"* ]]; then
    dateline="# $display_date - 📆 Week $week_number"
  fi

  echo -e "${dateline}\n"

  # Display Oura health data if available
  if [[ -n "$OURA_PAT" ]]; then
    show_oura_data_with_date
  fi

  # Process and display prompts
  process_prompts

  # Display main schedule table
  local title="## 🪢 Todo Today"
  local table_header="| Time    | Item                                                                                   |"
  local table_separator="|---------|----------------------------------------------------------------------------------------|"
  local kicker="\n******* DO WHATEVER THE SCHEDULE TELLS ME. AND ONLY THAT.**********\n\n\n"

  echo -e "${title}\n${table_header}\n${table_separator}\n${body}\n\n"
  echo -e "${kicker}"

  # Show git activity report if yday-semantic exists
  if command -v yday-semantic >/dev/null 2>&1; then
    yday-semantic
  fi

  # Show the Later Today section
  local filtered_appointments=$(gday_parse_filtered_appointments)
  echo "$body" | generate_later_today_h2s "$filtered_appointments"
}

# Run main function with all arguments
main "$@"
